# ================================================
# CHEM-MODINV — Variables de entorno
# Copiar como .env en la raíz del proyecto
# ================================================

# Django
# Generar cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=chem-modinv-cambiar-por-clave-aleatoria-segura-2024
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
JWT_SECRET_KEY=chem-modinv-jwt-secret-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_SECONDS=3600
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# Base de datos MySQL
DB_NAME=chem_modinv_db
DB_USER=root
DB_PASSWORD=12345
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo (bienvenida y código para restablecer contraseña)
# Si EMAIL_HOST queda vacío, los correos se imprimen en la consola del servidor.
# Con Gmail se usa una "contraseña de aplicación" de 16 letras, no la normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-letras
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CHEM-MODINV <tu-cuenta@gmail.com>

# Dirección del frontend (los correos enlazan a ella)
FRONTEND_URL=http://localhost:4200

# Minutos de validez del código para restablecer la contraseña
PASSWORD_RESET_CODE_MINUTES=15

# Cifrado de peticiones. False lo apaga (para depurar o usar Swagger).
CIFRADO_ACTIVO=True